# --- Contacto / WhatsApp (públicas, expuestas al cliente) ---
# Número de WhatsApp de ventas en formato internacional, sin "+" ni espacios.
# Vacío: no se pinta ningún botón de WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Email de contacto mostrado en la web y destino del formulario.
# Vacío: no se muestra correo y el formulario responde con un error.
NEXT_PUBLIC_CONTACT_EMAIL=

# Redes sociales (opcionales). Si se dejan vacías, no se muestran.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# --- Formulario de contacto (servidor) ---
# API key de Resend (https://resend.com). Sin ella, el formulario responde con un error al usuario.
RESEND_API_KEY=
# Remitente verificado en Resend. Por defecto usa el sandbox de Resend.
RESEND_FROM=Pedily <onboarding@resend.dev>
