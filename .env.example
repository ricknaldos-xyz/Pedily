# --- Contacto / WhatsApp (públicas, expuestas al cliente) ---
# Número de WhatsApp de ventas en formato internacional, sin "+" ni espacios.
# Vacío: no se pinta ningún botón de WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Email de contacto mostrado en la web y destino del formulario.
# Vacío: no se muestra correo y el formulario responde con un error.
NEXT_PUBLIC_CONTACT_EMAIL=

# Redes sociales (opcionales). Si se dejan vacías, no se muestran.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Número del bot de WhatsApp de DEMOSTRACIÓN (sin "+" ni espacios).
# Vacío: el botón «Prueba el bot por WhatsApp» no se muestra en ningún sitio.
NEXT_PUBLIC_DEMO_BOT_WHATSAPP=

# --- Formulario de contacto (servidor) ---
# API key de Resend (https://resend.com). Sin ella, el formulario responde con un error al usuario.
RESEND_API_KEY=
# Remitente verificado en Resend. Por defecto usa el sandbox de Resend.
RESEND_FROM=Pedily <onboarding@resend.dev>

# --- Consola de altas (servidor; tarea X-007, pedily/pedily-consola) ---
# URL https a la que /api/contact envía las solicitudes «Crear mi tienda».
# Vacía: «Crear mi tienda» llega solo por correo y el equipo crea la tienda.
# Con valor: se envía a la consola y además por correo; si la consola falla,
# la solicitud se queda en el correo. La página se genera al compilar:
# cambiarla exige volver a desplegar.
CONSOLA_SOLICITUDES_URL=
# Portador compartido con la consola (la misma CONSOLA_TOKEN_LANDING en las
# dos). Con valor, /api/contact manda «Authorization: Bearer <token>» y la IP
# del visitante en «x-pedily-ip-cliente», y la consola cuenta su límite de
# solicitudes por visitante. Vacía: todas cuentan con la IP de esta función.
CONSOLA_TOKEN_LANDING=
